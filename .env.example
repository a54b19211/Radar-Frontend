# zktest 本机开发配置；现役 4022 的服务配置继续由原部署维护。
HOST=127.0.0.1
PORT=3234
FABRIC_URL=http://127.0.0.1:18511
FABRIC_LABEL=zktest 现役资料库
FABRIC_HOST_LABEL=zktest
# 填入由管理员提供的 History 只读令牌文件路径，文件放在项目外，权限为 0600。
# FABRIC_HISTORY_TOKEN_FILE=/home/zk_test/.config/bioradar-console/history-read-token
# 默认关闭范围较大的图谱总览查询。
FABRIC_PIPELINE_OVERVIEW=false
# 后续可配置的只读采集遥测接口，仅由服务端访问；当前无需填写。
# COLLECTION_STATUS_URL=http://127.0.0.1:18511/api/collection/overview
# COLLECTION_READ_TOKEN=
